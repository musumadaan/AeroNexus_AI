# Copy to backend/.env (git-ignored) and fill in. Real environment variables override this file.

# --- Free LLM via Groq (Llama) -------------------------------------------------
# 1. Create a free API key at https://console.groq.com/keys
# 2. Paste it below. Nothing else is needed: Llama 3.1 8B answers first, Llama 3.3 70B handles escalations,
#    and the judge uses a different open model family (gpt-oss-20b) so it isn't grading its own family's answers.
AERONEXUS_LLM_PROVIDER=groq
AERONEXUS_JUDGE_PROVIDER=groq
GROQ_API_KEY=

# Optional overrides
# AERONEXUS_SMALL_MODEL=llama-3.1-8b-instant
# AERONEXUS_LARGE_MODEL=llama-3.3-70b-versatile
# AERONEXUS_JUDGE_MODEL=openai/gpt-oss-20b
# AERONEXUS_GROQ_RPM=28               # client-side pacing; lower it if your account limits are tighter
# AERONEXUS_MAX_RATE_LIMIT_WAIT_S=30  # longer waits degrade to rules + human review instead of hanging

# Fully offline instead (no key): AERONEXUS_LLM_PROVIDER=mock   or a local model: AERONEXUS_LLM_PROVIDER=ollama

# Routing thresholds (human in the loop)
AERONEXUS_AUTO_ACCEPT=0.90
AERONEXUS_ESCALATE=0.60
